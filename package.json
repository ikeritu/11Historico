{
  "name": "futbol11",
  "private": true,
  "version": "0.24.2-a.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
