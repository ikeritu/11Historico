    "qa:european-qualification": "vite build --ssr scripts/qaEuropeanQualification.ts --outDir .audit-dist --emptyOutDir false && node .audit-dist/qaEuropeanQualification.js",
    "qa:european-qualification-ui": "vite build --ssr scripts/qaEuropeanQualificationUi.ts --outDir .audit-dist --emptyOutDir false && node .audit-dist/qaEuropeanQualificationUi.js",
    "qa:european-persistence": "vite build --ssr scripts/qaEuropeanPersistence.ts --outDir .audit-dist --emptyOutDir false && node .audit-dist/qaEuropeanPersistence.js",
    "qa:european-tournament": "vite build --ssr scripts/qaEuropeanTournamentSkeleton.ts --outDir .audit-dist --emptyOutDir false && node .audit-dist/qaEuropeanTournamentSkeleton.js",
    "qa:european-match-engine": "vite build --ssr scripts/qaEuropeanMatchEngine.ts --outDir .audit-dist --emptyOutDir false && node .audit-dist/qaEuropeanMatchEngine.js",
    "qa:european-calendar": "vite build --ssr scripts/qaEuropeanCalendarIntegration.ts --outDir .audit-dist --emptyOutDir false && node .audit-dist/qaEuropeanCalendarIntegration.js",
    "qa:european-matchday-ui": "vite build --ssr scripts/qaEuropeanMatchdayUi.ts --outDir .audit-dist --emptyOutDir false && node .audit-dist/qaEuropeanMatchdayUi.js"
