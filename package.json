    "qa:mobile-viewport": "vite build --ssr scripts/qaMobileViewportFix.ts --outDir .audit-dist --emptyOutDir false && node .audit-dist/qaMobileViewportFix.js",
    "qa:hooks-simulation-deps": "vite build --ssr scripts/qaHooksSimulationDeps.ts --outDir .audit-dist --emptyOutDir false && node .audit-dist/qaHooksSimulationDeps.js",
