    "qa:global-ranking-ui": "vite build --ssr scripts/qaGlobalRankingUiPolish.ts --outDir .audit-dist --emptyOutDir false && node .audit-dist/qaGlobalRankingUiPolish.js",
    "qa:release-stabilization": "vite build --ssr scripts/qaReleaseStabilization.ts --outDir .audit-dist --emptyOutDir false && node .audit-dist/qaReleaseStabilization.js",
    "qa:agentjacking": "vite build --ssr scripts/qaAgentjackingGuardrails.ts --outDir .audit-dist --emptyOutDir false && node .audit-dist/qaAgentjackingGuardrails.js",
    "qa:season-luck-wheel": "vite build --ssr scripts/qaSeasonLuckWheel.ts --outDir .audit-dist --emptyOutDir false && node .audit-dist/qaSeasonLuckWheel.js",
    "qa:season-luck-wheel-ui": "vite build --ssr scripts/qaSeasonLuckWheelUi.ts --outDir .audit-dist --emptyOutDir false && node .audit-dist/qaSeasonLuckWheelUi.js",
    "qa:palmares-showcase": "vite build --ssr scripts/qaPalmaresShowcase.ts --outDir .audit-dist --emptyOutDir false && node .audit-dist/qaPalmaresShowcase.js",
    "typecheck": "tsc -b",
    "lint:src": "eslint src scripts",
